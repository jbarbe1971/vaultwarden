# ---------------------------------------------------------------------------
# Configuration Vaultwarden — Synology
# Copiez ce fichier en .env et adaptez les valeurs. Ne versionnez JAMAIS .env.
# ---------------------------------------------------------------------------

# Version de l'image. Épinglez une version précise en production, par ex.
# VW_VERSION=1.34.3-alpine  (voir https://github.com/dani-garcia/vaultwarden/releases)
VW_VERSION=latest-alpine

# URL publique EXACTE (https obligatoire, sans slash final).
# Ex. avec le DDNS Synology : https://monnas.synology.me
#     avec un sous-domaine   : https://vault.mondomaine.lu
DOMAIN=https://vault.mondomaine.lu

# Dossier de données sur le NAS (créé via File Station dans le dossier partagé "docker").
DATA_PATH=/volume1/docker/vaultwarden/data

# Port HTTP local exposé par le conteneur (le reverse proxy DSM pointera dessus).
# Évitez les ports réservés par DSM : 5000, 5001, 7000-7001, 80, 443.
HTTP_PORT=8222

TZ=Europe/Luxembourg

# --- Inscriptions -----------------------------------------------------------
# Laissez true le temps de créer votre compte, puis repassez à false et
# relancez le projet.
SIGNUPS_ALLOWED=true
SIGNUPS_VERIFY=true
INVITATIONS_ALLOWED=true
# SIGNUPS_DOMAINS_WHITELIST=mondomaine.lu

# --- Page /admin ------------------------------------------------------------
# Générez un jeton haché (recommandé) :
#   sudo docker run --rm -it vaultwarden/server:latest-alpine /vaultwarden hash
# Collez la valeur $argon2id$... ci-dessous entre guillemets simples.
# ATTENTION : dans un fichier .env lu par docker compose, doublez chaque $ -> $$
# Laissez vide pour désactiver complètement /admin.
ADMIN_TOKEN=

# --- Fonctions --------------------------------------------------------------
SENDS_ALLOWED=true
EMERGENCY_ACCESS_ALLOWED=true
# Limite la création d'organisations à certains comptes (vide = tout le monde)
ORG_CREATION_USERS=
LOG_LEVEL=warn
ROCKET_WORKERS=4

# --- Notifications push mobiles (facultatif) --------------------------------
# Identifiants à obtenir sur https://bitwarden.com/host/
PUSH_ENABLED=false
PUSH_INSTALLATION_ID=
PUSH_INSTALLATION_KEY=

# --- SMTP (facultatif, recommandé) ------------------------------------------
SMTP_HOST=
SMTP_FROM=vaultwarden@mondomaine.lu
SMTP_FROM_NAME=Vaultwarden
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

# --- fail2ban ---------------------------------------------------------------
# Dossier contenant jail.d/ et filter.d/ (copiés depuis ce dépôt).
F2B_CONFIG_PATH=/volume1/docker/vaultwarden/fail2ban
F2B_VERSION=latest
F2B_LOG_LEVEL=INFO
F2B_DB_PURGE_AGE=30d
# En-tête d'où Vaultwarden extrait l'IP réelle du client. Doit correspondre à
# l'en-tête ajouté dans le proxy inversé DSM (X-Real-IP par défaut).
IP_HEADER=X-Real-IP
